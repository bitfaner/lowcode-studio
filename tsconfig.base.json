{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "jsx": "react",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": false,
    "baseUrl": ".",
    "paths": {
      "@lc/schema": ["packages/schema/src/index.ts"],
      "@lc/shared": ["packages/shared/src/index.ts"],
      "@lc/page-runtime": ["packages/page-runtime/src/index.ts"],
      "@lc/materials": ["packages/materials/src/index.ts"],
      "@lc/materials-react": ["packages/materials-react/src/index.ts"]
    }
  }
}
