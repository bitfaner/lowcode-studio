{
  "name": "lit-lowcode-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @lc/server --filter @lc/studio --filter @lc/runtime dev",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "dev:studio": "pnpm --filter @lc/studio dev",
    "dev:runtime": "pnpm --filter @lc/runtime dev",
    "dev:server": "pnpm --filter @lc/server dev",
    "vendor": "bash apps/studio/scripts/fetch-vendor.sh",
    "build:materials": "pnpm --filter @lc/materials-react build",
    "build:assets": "tsx tools/build-assets.ts",
    "check:materials": "tsx tools/check-material-parity.ts",
    "build:studio": "pnpm --filter @lc/studio build",
    "build:runtime": "pnpm --filter @lc/runtime build",
    "build": "pnpm build:materials && pnpm build:assets && pnpm check:materials && pnpm build:studio && pnpm build:runtime",
    "start": "pnpm --filter @lc/server start",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @lc/server typecheck",
    "e2e": "node tools/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright-core": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
